# Copy this file to `.env` and fill in real values. Never commit the real .env.

# development | production
# production: hides /docs & /openapi.json, enables HSTS header and Host-header checks
ENVIRONMENT="development"

# MongoDB. In production use an authenticated URI and a real DB name, and do NOT
# expose MongoDB to the public internet (bind to localhost or use Atlas + IP allowlist).
MONGO_URL="mongodb://localhost:27017"
DB_NAME="dahmi_logistics"

# Comma-separated allowed browser origins for CORS.
# Production example: "https://dahmilogistics.com,https://www.dahmilogistics.com"
CORS_ORIGINS="*"

# Comma-separated allowed Host headers (enforced only when ENVIRONMENT=production).
# Production example: "dahmilogistics.com,www.dahmilogistics.com"
ALLOWED_HOSTS="*"

# Per-IP rate limits for the public contact/careers forms (slowapi syntax)
CONTACT_RATE_LIMIT="5/minute"
CAREERS_RATE_LIMIT="3/minute"

# Resend email (https://resend.com). Get an API key from the dashboard.
# For production, verify your own domain and use a from-address on it.
RESEND_API_KEY=""
NOTIFY_EMAIL="dahmilogistics@gmail.com"
FROM_EMAIL="Dahmi Logistics <onboarding@resend.dev>"
